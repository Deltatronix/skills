diff -ruN base/src/editors/schematic/SchematicEditor.test.ts ref/src/editors/schematic/SchematicEditor.test.ts
--- base/src/editors/schematic/SchematicEditor.test.ts	1970-01-01 02:00:00
+++ ref/src/editors/schematic/SchematicEditor.test.ts	2026-10-29 22:11:59
@@ -0,0 +1,16 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSchematicEditor } from './SchematicEditor.ts';
+
+test('only the owner release unlocks another drag, including after cancel', () => {
+  const editor = createSchematicEditor();
+  const first = { pointerId: 1, x: 0, y: 0 };
+  const second = { pointerId: 2, x: 0, y: 0 };
+  assert.equal(editor.pointerDown(first), true);
+  assert.equal(editor.pointerDown(second), false);
+  editor.cancel(1);
+  editor.pointerUp(second);
+  assert.equal(editor.pointerDown(second), false);
+  editor.pointerUp(first);
+  assert.equal(editor.pointerDown(second), true);
+});
