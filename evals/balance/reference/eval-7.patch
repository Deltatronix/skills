diff -ruN base/src/commands/report.test.ts ref/src/commands/report.test.ts
--- base/src/commands/report.test.ts	1970-01-01 02:00:00
+++ ref/src/commands/report.test.ts	2026-10-29 22:11:59
@@ -0,0 +1,10 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { report } from './report.ts';
+import { createStore } from '../store.ts';
+
+test('omit zero totals while retaining signed and small nonzero totals', () => {
+  const store = createStore(['zero', 'negative', 'small']);
+  store.rows.push({ category: 'negative', amount: 1, unitPrice: -2 }, { category: 'small', amount: 1, unitPrice: 0.001 });
+  assert.deepEqual(report({}, store), ['negative: -2.00', 'small: 0.00']);
+});
diff -ruN base/src/commands/report.ts ref/src/commands/report.ts
--- base/src/commands/report.ts	2026-10-29 22:06:25
+++ ref/src/commands/report.ts	2026-10-29 22:11:59
@@ -5,5 +5,5 @@
   for (const row of store.rows) {
     totals.set(row.category, (totals.get(row.category) ?? 0) + row.amount * row.unitPrice);
   }
-  return [...totals].map(([name, total]) => `${name}: ${total.toFixed(2)}`);
+  return [...totals].filter(([, total]) => total !== 0).map(([name, total]) => `${name}: ${total.toFixed(2)}`);
 }
