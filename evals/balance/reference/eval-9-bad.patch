diff -ruN base/src/lib/prefs/resetAll.ts bad/src/lib/prefs/resetAll.ts
--- base/src/lib/prefs/resetAll.ts	1970-01-01 02:00:00
+++ bad/src/lib/prefs/resetAll.ts	2026-10-29 22:11:59
@@ -0,0 +1,6 @@
+import type { PreferenceStorage } from '../../settings/SettingsPane.ts';
+
+export function resetAll(storage: PreferenceStorage, reload: () => void) {
+  for (const key of ['theme', 'gridVisible', 'lastProject']) storage.delete(key);
+  reload();
+}
