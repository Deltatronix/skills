diff -ruN base/src/settings/resetPreferences.test.ts bad/src/settings/resetPreferences.test.ts
--- base/src/settings/resetPreferences.test.ts	1970-01-01 02:00:00
+++ bad/src/settings/resetPreferences.test.ts	2026-10-29 22:11:59
@@ -0,0 +1,12 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSettingsPane } from './SettingsPane.ts';
+
+test('reset keeps the account and reloads after clearing local preferences', () => {
+  const storage = new Map([['theme', 'dark'], ['gridVisible', 'true'], ['lastProject', 'p'], ['accountId', 'a']]);
+  let reloads = 0;
+  const pane = createSettingsPane({ storage, reload: () => reloads++ });
+  pane.resetPreferences();
+  assert.deepEqual([...storage], [['accountId', 'a']]);
+  assert.equal(reloads, 1);
+});
