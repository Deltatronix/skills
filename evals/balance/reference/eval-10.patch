-    const angle = arc.startAngle + (arc.endAngle - arc.startAngle) * i / segments;
+export function tessellateArc(arc: Arc) {
+  return Array.from({ length: ARC_SEGMENTS + 1 }, (_, i) => {
+    const angle = arc.startAngle + (arc.endAngle - arc.startAngle) * i / ARC_SEGMENTS;
     return { x: arc.cx + arc.radius * Math.cos(angle), y: arc.cy + arc.radius * Math.sin(angle) };
   });
 }
